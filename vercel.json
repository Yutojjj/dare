{
  "rewrites": [
    { "source": "/watch", "destination": "/watch/index.html" },
    { "source": "/watch/", "destination": "/watch/index.html" },
    { "source": "/", "destination": "/dare.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
