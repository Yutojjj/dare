{
  "manifest_version": 2,
  "name": "Dare watch navigation",
  "version": "1.2",
  "browser_specific_settings": {"gecko": {"id": "watch-navigation@dare.local"}},
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"],
  "content_scripts": [{
    "matches": ["https://dare-alpha-ten.vercel.app/watch/*", "http://127.0.0.1/watch/*"],
    "js": ["navigation.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
